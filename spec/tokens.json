{
  "$comment": "Shared design tokens for Reader (Mac) and the phone app. Highlight palette and opacity mirror ReaderCore (HighlightPalette.hex, HighlightAppearance.opacity); files store colors as 1...6, so order is part of the contract. Owner: Designer.",
  "version": 2,
  "highlight": {
    "opacity": 0.38,
    "palette": [
      { "id": 1, "hex": "#F2C94C" },
      { "id": 2, "hex": "#6FCF97" },
      { "id": 3, "hex": "#56CCF2" },
      { "id": 4, "hex": "#F28FB1" },
      { "id": 5, "hex": "#BB6BD9" },
      { "id": 6, "hex": "#F2994A" }
    ],
    "default": 1
  },
  "syncStatus": {
    "$comment": "The status chip is the only sync UI. Dot color plus a text label, never color alone.",
    "synced": { "dot": "#27AE60", "label": "Synced" },
    "syncing": { "dot": "#2F80ED", "label": "Syncing…", "animate": "pulse" },
    "offline": { "dot": "#8E8E93", "label": "Offline, changes saved" },
    "conflict": { "dot": "#F2994A", "label": "2 versions to review" },
    "error": { "dot": "#EB5757", "label": "Can't reach Mac mini", "action": "Retry" },
    "storageFull": {
      "dot": "#EB5757",
      "label": "Mac mini is full",
      "detail": "Books paused. Highlights and notes still sync.",
      "action": "Check again",
      "bookBadge": "Waiting for space"
    },
    "$priority": ["error", "storageFull", "conflict", "offline", "syncing", "synced"]
  },
  "space": [4, 8, 12, 16, 24, 32],
  "radius": { "chip": 999, "card": 12, "sheet": 16, "highlightBar": 2 },
  "type": {
    "$comment": "Phone sizes in pt/sp; Mac keeps system sizes.",
    "title": { "size": 22, "weight": 600, "lineHeight": 28 },
    "heading": { "size": 17, "weight": 600, "lineHeight": 22 },
    "body": { "size": 16, "weight": 400, "lineHeight": 24 },
    "quote": { "size": 15, "weight": 400, "lineHeight": 22, "style": "serif" },
    "caption": { "size": 13, "weight": 400, "lineHeight": 18 }
  },
  "touchTarget": { "min": 44 }
}
