{
  "expo": {
    "name": "Reader",
    "slug": "reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "readersync",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.reader.Reader",
      "supportsTablet": true
    },
    "android": {
      "package": "com.reader",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "readersync",
              "host": "pair"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Reader uses the camera to scan the pairing code shown in Reader on your Mac.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withDebugCleartext"
    ]
  }
}
