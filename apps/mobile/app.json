{
  "expo": {
    "name": "Reader",
    "slug": "reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.reader.Reader",
      "supportsTablet": true
    },
    "android": {
      "package": "com.reader"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "./plugins/withDebugCleartext"
    ]
  }
}
